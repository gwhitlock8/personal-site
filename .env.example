# Copy to .env.local for local dev. In Vercel, add these under Project > Settings > Environment Variables.

# Required: from https://platform.moonshot.ai (top up at least $1 to unlock kimi-k3)
MOONSHOT_API_KEY=

# Optional overrides
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k3
# KIMI_REASONING_EFFORT=low   # low | high | max

# Optional: chat logs, leads, rate limiting. Added automatically when you
# connect Upstash Redis from the Vercel Marketplace.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Admin (private job search tracker at /admin) ----
# Generate these three with: npm run admin:setup
# ADMIN_PASSWORD_HASH=
# ADMIN_TOTP_SECRET=
# ADMIN_SESSION_SECRET=
#
# Admin data uses the Upstash database above, under an "admin:" key prefix.
# Optional: a separate database instead, connected with the env var prefix "ADMIN":
# ADMIN_KV_REST_API_URL=
# ADMIN_KV_REST_API_TOKEN=
#
# Local testing only: keep admin data in memory instead of Upstash (lost on restart).
# ADMIN_STORE=memory
#
# Shared secret for the Gmail Apps Script (npm run admin:ingest-secret).
# ADMIN_INGEST_SECRET=
#
# Max Kimi calls per minute for email classification (default 50 = half of Moonshot Tier 2's 100 RPM).
# ADMIN_MODEL_RPM=50

# Tailored resumes: create a PRIVATE Blob store in Vercel (Storage → Blob); connecting it adds this.
BLOB_READ_WRITE_TOKEN=
